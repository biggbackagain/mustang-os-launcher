<resources>
    <style name="Theme.Mustang" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/ui_accent</item>
        <item name="android:colorControlNormal">@color/ui_muted</item>
        <item name="android:colorControlActivated">@color/ui_accent</item>
        <item name="android:colorControlHighlight">@color/ui_ripple</item>
        <item name="android:colorBackground">@color/ui_background</item>
        <item name="android:textColorPrimary">@color/ui_text</item>
        <item name="android:textColorSecondary">@color/ui_muted</item>
        <item name="android:windowBackground">@color/ui_background</item>
        <item name="android:navigationBarColor">@color/ui_background</item>
        <item name="android:statusBarColor">@color/ui_background</item>
        <item name="android:buttonStyle">@style/ActionButton</item>
        <item name="android:editTextStyle">@style/OemEditText</item>
        <item name="android:alertDialogTheme">@style/Theme.Mustang.Dialog</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Mustang.Dialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/ui_accent</item>
        <item name="android:colorBackground">@color/ui_surface</item>
        <item name="android:textColorPrimary">@color/ui_text</item>
        <item name="android:textColorSecondary">@color/ui_muted</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:editTextStyle">@style/OemEditText</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/OemDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/OemDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/OemDialogButton</item>
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">92%</item>
    </style>
    <style name="Body">
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="Muted" parent="Body">
        <item name="android:textColor">@color/ui_muted</item>
        <item name="android:textSize">@dimen/muted_size</item>
    </style>
    <style name="Title" parent="Body">
        <item name="android:textSize">@dimen/title_size</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="PanelCaption" parent="Muted">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/card_padding</item>
    </style>
    <style name="ActionButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/action_text_size</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>
    <style name="OemDialogButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/ui_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="OemEditText" parent="android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:textColorHint">@color/ui_dim</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
    <style name="MediaButton">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:tint">@color/ui_text</item>
        <item name="android:padding">14dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
    <style name="DockButton" parent="ActionButton">
        <item name="android:drawablePadding">4dp</item>
        <item name="android:textSize">@dimen/dock_text_size</item>
        <item name="android:padding">6dp</item>
    </style>
</resources>
