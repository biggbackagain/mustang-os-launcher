<resources>
    <style name="Theme.Mustang" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#FF354A</item>
        <item name="android:windowBackground">#090B0F</item>
        <item name="android:navigationBarColor">#090B0F</item>
        <item name="android:statusBarColor">#090B0F</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Body"><item name="android:textColor">#F4F5F7</item><item name="android:textSize">16sp</item></style>
    <style name="Muted" parent="Body"><item name="android:textColor">#B0B5C0</item><item name="android:textSize">@dimen/muted_size</item></style>
    <style name="Title" parent="Body"><item name="android:textSize">@dimen/title_size</item><item name="android:fontFamily">sans-serif-medium</item></style>
    <style name="Card"><item name="android:background">@drawable/bg_card</item><item name="android:padding">@dimen/card_padding</item></style>
    <style name="ActionButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/bg_button</item><item name="android:textColor">#F4F5F7</item><item name="android:textAllCaps">false</item><item name="android:textSize">15sp</item><item name="android:minHeight">52dp</item><item name="android:paddingLeft">12dp</item><item name="android:paddingRight">12dp</item>
    </style>
    <style name="MediaButton"><item name="android:background">@drawable/bg_button</item><item name="android:tint">#F4F5F7</item><item name="android:padding">14dp</item><item name="android:scaleType">fitCenter</item></style>
    <style name="DockButton" parent="ActionButton"><item name="android:drawablePadding">7dp</item><item name="android:textSize">14sp</item><item name="android:padding">8dp</item></style>
</resources>
