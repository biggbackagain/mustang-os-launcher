<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#090B0F" android:paddingLeft="16dp" android:paddingRight="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView style="@style/Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dashboard_1" android:fontFamily="sans-serif-black" android:letterSpacing="0.12"/>
        <TextView style="@style/Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dashboard_2" android:textColor="#FF354A" android:fontFamily="sans-serif-black"/>
        <TextView style="@style/Muted" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/dashboard_3" android:paddingStart="12dp" android:paddingEnd="0dp"/>
        <TextView android:id="@+id/connectivity" style="@style/Muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dashboard_4" android:layout_marginEnd="20dp"/>
        <TextClock android:id="@+id/clock" style="@style/Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="h:mm a" android:format24Hour="HH:mm"/>
        <ImageButton android:id="@+id/topSettings" style="@style/MediaButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="16dp" android:src="@drawable/ic_settings" android:contentDescription="@string/dashboard_5"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false">
        <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.29" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_music" android:importantForAccessibility="no"/>
                <TextView style="@style/Title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/dashboard_6" android:paddingStart="10dp" android:paddingEnd="0dp"/>
            </LinearLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp" android:layout_marginBottom="10dp">
                <ImageView android:id="@+id/albumArt" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="@string/dashboard_7" android:visibility="gone"/>
                <LinearLayout android:id="@+id/artPlaceholder" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:background="@drawable/bg_button">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_music" android:alpha="0.5" android:importantForAccessibility="no"/>
                    <TextView android:id="@+id/artHint" style="@style/Muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dashboard_8" android:layout_marginTop="10dp"/>
                </LinearLayout>
            </FrameLayout>
            <TextView android:id="@+id/songTitle" style="@style/Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dashboard_9" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/songArtist" style="@style/Muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dashboard_10" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp"/>
            <TextView android:id="@+id/songAlbum" style="@style/Muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:maxLines="1" android:ellipsize="end"/>
            <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:progressTint="#FF354A" android:progressBackgroundTint="#353B47" android:layout_marginTop="12dp" android:max="1000" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/songTime" style="@style/Muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dashboard_11" android:layout_marginTop="4dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:gravity="center" android:layout_marginTop="8dp">
                <ImageButton android:id="@+id/previous" style="@style/MediaButton" android:layout_width="52dp" android:layout_height="52dp" android:contentDescription="@string/dashboard_12" android:src="@drawable/ic_previous" android:enabled="false"/>
                <ImageButton android:id="@+id/playPause" style="@style/MediaButton" android:layout_width="60dp" android:layout_height="60dp" android:layout_marginHorizontal="14dp" android:background="@drawable/bg_primary" android:contentDescription="@string/dashboard_13" android:src="@drawable/ic_play" android:enabled="false"/>
                <ImageButton android:id="@+id/next" style="@style/MediaButton" android:layout_width="52dp" android:layout_height="52dp" android:contentDescription="@string/dashboard_14" android:src="@drawable/ic_next" android:enabled="false"/>
            </LinearLayout>
            <TextView android:id="@+id/mediaStatus" style="@style/Muted" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:text="@string/dashboard_15" android:textSize="12sp" android:maxLines="2"/>
            <Button android:id="@+id/mediaSource" style="@style/ActionButton" android:layout_width="match_parent" android:layout_height="48dp" android:minHeight="48dp" android:text="@string/dashboard_16"/>
        </LinearLayout>
        <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.42" android:layout_marginHorizontal="12dp" android:orientation="vertical" android:padding="12dp">
            <TextView style="@style/Muted" android:layout_width="match_parent" android:layout_height="24dp" android:text="@string/dashboard_17" android:letterSpacing="0.18" android:gravity="center" android:textSize="12sp"/>
            <com.mustangos.launcher.ui.SpeedGaugeView android:id="@+id/gauge" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.85" android:contentDescription="@string/dashboard_18"/>
            <Button android:id="@+id/gpsStatus" style="@style/ActionButton" android:layout_width="match_parent" android:layout_height="48dp" android:minHeight="48dp" android:text="@string/dashboard_19" android:textSize="13sp"/>
            <ImageView android:id="@+id/carImage" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.15" android:src="@drawable/mustang_2010" android:scaleType="centerCrop" android:contentDescription="@string/dashboard_20"/>
            <TextView style="@style/Title" android:layout_width="match_parent" android:layout_height="28dp" android:text="@string/dashboard_21" android:gravity="center" android:textSize="16sp"/>
            <TextView style="@style/Muted" android:layout_width="match_parent" android:layout_height="24dp" android:text="@string/dashboard_22" android:gravity="center" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.29" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_navigation" android:importantForAccessibility="no"/>
                <TextView style="@style/Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dashboard_23" android:paddingStart="10dp" android:paddingEnd="0dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_navigation" android:alpha="0.65" android:importantForAccessibility="no"/>
                <TextView style="@style/Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dashboard_24" android:gravity="center" android:layout_marginTop="18dp"/>
                <TextView style="@style/Muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dashboard_25" android:gravity="center" android:layout_marginTop="12dp"/>
                <TextView android:id="@+id/carplayStatus" style="@style/Muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dashboard_26" android:gravity="center" android:layout_marginTop="16dp" android:textSize="12sp"/>
            </LinearLayout>
            <Button android:id="@+id/openCarplay" style="@style/ActionButton" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/bg_primary" android:text="@string/dashboard_27"/>
            <Button android:id="@+id/openMaps" style="@style/ActionButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/dashboard_28" android:layout_marginTop="10dp"/>
            <TextView style="@style/Muted" android:layout_width="match_parent" android:layout_height="42dp" android:text="@string/dashboard_29" android:gravity="center" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/dock" android:layout_width="match_parent" android:layout_height="96dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:orientation="horizontal" android:baselineAligned="false">
        <Button android:id="@+id/dockMusic" style="@style/DockButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:drawableTop="@drawable/ic_music" android:text="@string/dashboard_30"/>
        <Button android:id="@+id/dockCarplay" style="@style/DockButton" android:layout_width="0dp" android:layout_weight="1.15" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:drawableTop="@drawable/ic_carplay" android:text="@string/dashboard_31"/>
        <Button android:id="@+id/dockNavigation" style="@style/DockButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:drawableTop="@drawable/ic_navigation" android:text="@string/dashboard_32"/>
        <Button android:id="@+id/dockPhone" style="@style/DockButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:drawableTop="@drawable/ic_phone" android:text="@string/dashboard_33"/>
        <Button android:id="@+id/dockRadio" style="@style/DockButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:drawableTop="@drawable/ic_radio" android:text="@string/dashboard_34"/>
        <Button android:id="@+id/dockApps" style="@style/DockButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:drawableTop="@drawable/ic_apps" android:text="@string/dashboard_35"/>
        <Button android:id="@+id/dockEngine" style="@style/DockButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:drawableTop="@drawable/ic_engine" android:text="@string/dashboard_36"/>
        <Button android:id="@+id/dockSettings" style="@style/DockButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:drawableTop="@drawable/ic_settings" android:text="@string/dashboard_37"/>
    </LinearLayout>
</LinearLayout>
