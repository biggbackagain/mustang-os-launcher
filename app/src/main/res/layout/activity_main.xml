<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_midnight_blue" android:paddingStart="@dimen/dashboard_outer_padding" android:paddingEnd="@dimen/dashboard_outer_padding">
    <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/toolbar_height" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/brandLogo" android:layout_width="@dimen/brand_logo_width" android:layout_height="@dimen/brand_logo_height" android:layout_marginEnd="10dp" android:scaleType="fitCenter" android:importantForAccessibility="no" android:src="@drawable/ic_mustang_pony" />
        <TextView style="@style/Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-black" android:letterSpacing=".09" android:text="@string/brand_name" />
        <TextView style="@style/Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ui_accent" android:fontFamily="sans-serif-black" android:text="@string/brand_os" />
        <TextView style="@style/Muted" android:id="@+id/vehicleProfileHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="16dp" android:paddingEnd="8dp" android:maxLines="1" android:ellipsize="end" android:text="@string/vehicle_subtitle" />
        <TextView style="@style/PanelCaption" android:id="@+id/topDoorStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ui_alert" android:visibility="gone" android:layout_marginEnd="12dp" android:text="@string/oem_opening_badge" />
        <TextView style="@style/Muted" android:id="@+id/topBattery" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="16dp" android:text="@string/header_voltage_unknown" />
        <TextView style="@style/Muted" android:id="@+id/connectivity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="16dp" android:text="@string/network_pending" />
        <TextClock style="@style/Title" android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="h:mm a" android:format24Hour="HH:mm" />
        <ImageButton style="@style/MediaButton" android:id="@+id/topSettings" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="12dp" android:src="@drawable/ic_settings" android:contentDescription="@string/settings_description" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ui_border" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false" android:paddingTop="8dp">
        <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight=".27" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:tint="@color/ui_accent" android:importantForAccessibility="no" android:src="@drawable/ic_music" />
                <TextView style="@style/Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="8dp" android:maxLines="1" android:ellipsize="end" android:text="@string/media_title" />
                <Button style="@style/ActionButton" android:id="@+id/dockRadio" android:layout_width="64dp" android:layout_height="48dp" android:text="@string/dock_radio" android:textSize="12sp" android:paddingStart="4dp" android:paddingEnd="4dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false" android:layout_marginTop="8dp" android:layout_marginBottom="8dp">
                <FrameLayout android:layout_width="@dimen/media_art_size" android:layout_height="@dimen/media_art_size" android:background="@drawable/bg_artwork" android:clipToOutline="true" android:layout_marginEnd="12dp">
                    <ImageView android:id="@+id/albumArt" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@string/artwork_description" android:visibility="gone" />
                    <LinearLayout android:id="@+id/artPlaceholder" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_artwork">
                        <ImageView android:layout_width="@dimen/art_placeholder_icon" android:layout_height="@dimen/art_placeholder_icon" android:tint="@color/ui_dim" android:importantForAccessibility="no" android:src="@drawable/ic_music" />
                        <TextView style="@style/Muted" android:id="@+id/artHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp" android:padding="8dp" android:maxLines="2" android:text="@string/carplay_music_hint" />
                    </LinearLayout>
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/Title" android:id="@+id/songTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="@dimen/media_title_size" android:maxLines="3" android:ellipsize="end" android:text="@string/media_no_data" />
                    <TextView style="@style/Muted" android:id="@+id/songArtist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="@dimen/media_artist_size" android:layout_marginTop="6dp" android:maxLines="2" android:ellipsize="end" android:text="@string/media_connect_source" />
                    <TextView style="@style/Muted" android:id="@+id/songAlbum" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:textSize="12sp" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
            <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="4dp" android:progressTint="@color/ui_accent" android:progressBackgroundTint="@color/ui_border" android:max="1000" android:importantForAccessibility="no" />
            <TextView style="@style/Muted" android:id="@+id/songTime" android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center_vertical" android:textSize="12sp" android:maxLines="1" android:text="@string/media_unknown_time" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/play_size" android:gravity="center" android:layout_marginTop="6dp">
                <ImageButton style="@style/MediaButton" android:id="@+id/previous" android:layout_width="@dimen/control_size" android:layout_height="@dimen/control_size" android:src="@drawable/ic_previous" android:contentDescription="@string/media_previous" android:enabled="false" />
                <ImageButton style="@style/MediaButton" android:id="@+id/playPause" android:layout_width="@dimen/play_size" android:layout_height="@dimen/play_size" android:src="@drawable/ic_play_pause" android:contentDescription="@string/media_toggle" android:enabled="false" android:layout_marginHorizontal="@dimen/control_spacing" android:background="@drawable/bg_primary" />
                <ImageButton style="@style/MediaButton" android:id="@+id/next" android:layout_width="@dimen/control_size" android:layout_height="@dimen/control_size" android:src="@drawable/ic_next" android:contentDescription="@string/media_next" android:enabled="false" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
                <TextView style="@style/Muted" android:id="@+id/mediaStatus" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:gravity="center_vertical" android:layout_marginEnd="8dp" android:text="@string/media_no_access" />
                <Button style="@style/ActionButton" android:id="@+id/mediaSource" android:layout_width="80dp" android:layout_height="48dp" android:text="@string/media_choose_source" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight=".35" android:layout_marginHorizontal="@dimen/dashboard_gap" android:orientation="vertical">
            <TextView style="@style/PanelCaption" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center" android:text="@string/your_mustang" android:id="@+id/vehicleProfileTitle" />
            <com.mustangos.launcher.ui.SpeedGaugeView android:id="@+id/gauge" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight=".7" android:contentDescription="@string/gps_unknown_description" />
            <Button style="@style/ActionButton" android:id="@+id/gpsStatus" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/gps_enable" android:textSize="12sp" android:maxLines="2" />
            <com.mustangos.launcher.ui.MustangCarView android:id="@+id/carImage" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.3" android:src="@drawable/mustang_2010" android:scaleType="fitCenter" android:contentDescription="@string/vehicle_description" />
            <TextView android:id="@+id/vehicleImageReference" style="@style/Muted" android:layout_width="match_parent" android:layout_height="16dp" android:textSize="10sp" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:text="@string/vehicle_stock_image_caption" />
            <TextView style="@style/PanelCaption" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center" android:text="@string/engine_label" android:id="@+id/vehicleProfileSubtitle" />
            <TextView style="@style/Muted" android:id="@+id/vehicleInfo" android:layout_width="match_parent" android:layout_height="40dp" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:gravity="center" android:text="@string/gps_disclaimer" />
        </LinearLayout>
        <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight=".38" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/map_header_height" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:tint="@color/ui_accent" android:importantForAccessibility="no" android:src="@drawable/ic_navigation" />
                <TextView style="@style/Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="8dp" android:maxLines="1" android:text="@string/navigation_title" />
            </LinearLayout>
            <TextView style="@style/Muted" android:id="@+id/navigationDescription" android:layout_width="match_parent" android:layout_height="@dimen/map_caption_height" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:text="@string/navigation_carplay_explanation" />
            <TextView android:id="@+id/mapStatus" style="@style/Muted" android:layout_width="match_parent" android:layout_height="24dp" android:textSize="12sp" android:gravity="center_vertical" android:maxLines="1" android:singleLine="true" android:ellipsize="end" android:text="@string/map_idle_hint" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/bg_map_panel" android:clipToOutline="true" android:layout_marginTop="8dp" android:layout_marginBottom="8dp">
                <FrameLayout android:id="@+id/mapHost" android:layout_width="match_parent" android:layout_height="match_parent" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_margin="@dimen/map_controls_margin" android:orientation="@integer/map_controls_orientation" android:gravity="end">
                    <Button style="@style/ActionButton" android:id="@+id/mapZoomIn" android:layout_width="88dp" android:layout_height="48dp" android:text="@string/map_zoom_in_symbol" android:textSize="24sp" android:contentDescription="@string/map_zoom_in" android:maxLines="1" android:singleLine="true" />
                    <Button style="@style/ActionButton" android:id="@+id/mapZoomOut" android:layout_width="88dp" android:layout_height="48dp" android:layout_marginTop="@dimen/map_controls_vertical_gap" android:text="@string/map_zoom_out_symbol" android:textSize="24sp" android:contentDescription="@string/map_zoom_out" android:maxLines="1" android:singleLine="true" android:layout_marginStart="@dimen/map_controls_horizontal_gap" />
                    <Button style="@style/ActionButton" android:id="@+id/mapFollow" android:layout_width="88dp" android:layout_height="48dp" android:text="@string/map_follow" android:layout_marginTop="@dimen/map_controls_vertical_gap" android:textColor="@color/ui_accent" android:background="@drawable/bg_primary" android:maxLines="1" android:singleLine="true" android:layout_marginStart="@dimen/map_controls_horizontal_gap" android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
                <Button style="@style/ActionButton" android:id="@+id/openCarplay" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/carplay_open" android:layout_weight="1" android:layout_marginEnd="8dp" />
                <Button style="@style/ActionButton" android:id="@+id/openMaps" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/android_maps" android:layout_weight="1" />
            </LinearLayout>
            <TextView style="@style/Muted" android:id="@+id/mapAttribution" android:layout_width="match_parent" android:layout_height="48dp" android:visibility="gone" android:textSize="12sp" android:gravity="center_vertical" android:maxLines="2" android:clickable="true" android:focusable="true" android:contentDescription="@string/map_attribution_description" android:text="@string/map_attribution" />
            <TextView style="@style/Muted" android:id="@+id/carplayStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:text="@string/carplay_unknown_connection" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/dock" android:layout_width="match_parent" android:layout_height="@dimen/dock_height" android:paddingTop="8dp" android:paddingBottom="8dp" android:orientation="horizontal" android:baselineAligned="false">
        <Button style="@style/DockButton" android:id="@+id/dockMusic" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/dock_music" android:layout_weight="1" android:layout_marginEnd="@dimen/dashboard_gap" android:drawableTop="@drawable/ic_music" />
        <Button style="@style/DockButton" android:id="@+id/dockCarplay" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/dock_carplay" android:layout_weight="1" android:layout_marginEnd="@dimen/dashboard_gap" android:drawableTop="@drawable/ic_carplay" />
        <Button style="@style/DockButton" android:id="@+id/dockNavigation" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/dock_navigation" android:layout_weight="1" android:layout_marginEnd="@dimen/dashboard_gap" android:drawableTop="@drawable/ic_navigation" />
        <Button style="@style/DockButton" android:id="@+id/dockPhone" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/dock_phone" android:layout_weight="1" android:layout_marginEnd="@dimen/dashboard_gap" android:drawableTop="@drawable/ic_phone" />
        <Button style="@style/DockButton" android:id="@+id/dockApps" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/dock_apps" android:layout_weight="1" android:layout_marginEnd="@dimen/dashboard_gap" android:drawableTop="@drawable/ic_apps" />
        <Button style="@style/DockButton" android:id="@+id/dockEngine" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/dock_engine" android:layout_weight="1" android:layout_marginEnd="@dimen/dashboard_gap" android:drawableTop="@drawable/ic_engine" />
        <Button style="@style/DockButton" android:id="@+id/dockSettings" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/dock_settings" android:layout_weight="1" android:layout_marginEnd="0dp" android:drawableTop="@drawable/ic_settings" />
    </LinearLayout>
</LinearLayout>
