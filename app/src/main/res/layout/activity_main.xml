<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_mustang_theme" android:paddingStart="@dimen/dashboard_outer_padding" android:paddingEnd="@dimen/dashboard_outer_padding">
    <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/toolbar_height" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/brandLogo" android:layout_width="@dimen/brand_logo_width" android:layout_height="@dimen/brand_logo_height" android:layout_marginEnd="10dp" android:scaleType="fitCenter" android:importantForAccessibility="no" android:src="@drawable/ic_mustang_pony" />
        <TextView style="@style/Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-black" android:letterSpacing=".09" android:text="@string/brand_name" />
        <TextView style="@style/Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ui_accent" android:fontFamily="sans-serif-black" android:text="@string/brand_os" />
        <TextView style="@style/Muted" android:id="@+id/vehicleProfileHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="16dp" android:paddingEnd="8dp" android:maxLines="1" android:ellipsize="end" android:text="@string/vehicle_subtitle" />
        <TextView style="@style/HeaderChip" android:id="@+id/topDoorStatus" android:layout_width="wrap_content" android:layout_height="32dp" android:textColor="@color/ui_alert" android:visibility="gone" android:layout_marginEnd="8dp" android:text="@string/oem_opening_badge" />
        <TextView style="@style/HeaderChip" android:id="@+id/topBattery" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginEnd="8dp" android:text="@string/header_voltage_unknown" />
        <TextView style="@style/HeaderChip" android:id="@+id/connectivity" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginEnd="14dp" android:text="@string/network_pending" />
        <TextClock style="@style/Title" android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="@dimen/clock_size" android:fontFamily="sans-serif-light" android:format12Hour="h:mm" android:format24Hour="HH:mm" />
        <ImageButton style="@style/MediaButton" android:id="@+id/topSettings" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="12dp" android:src="@drawable/ic_settings" android:contentDescription="@string/settings_description" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false" android:paddingTop="4dp">
        <!-- Audio: large cover, title and controls reachable from the driver's seat. -->
        <LinearLayout style="@style/Card" android:id="@+id/mediaCard" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight=".28" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:tint="@color/ui_accent" android:importantForAccessibility="no" android:src="@drawable/ic_music" />
                <TextView style="@style/PanelCaption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="8dp" android:maxLines="1" android:ellipsize="end" android:text="@string/media_caption" />
                <Button style="@style/ActionButton" android:id="@+id/dockRadio" android:layout_width="64dp" android:layout_height="40dp" android:minHeight="40dp" android:text="@string/dock_radio" android:textSize="12sp" android:paddingStart="4dp" android:paddingEnd="4dp" />
            </LinearLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:layout_marginBottom="10dp">
                <com.mustangos.launcher.ui.SquareFrameLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="center" android:background="@drawable/bg_artwork" android:clipToOutline="true" android:elevation="6dp">
                    <ImageView android:id="@+id/albumArt" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@string/artwork_description" android:visibility="gone" />
                    <LinearLayout android:id="@+id/artPlaceholder" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_artwork">
                        <ImageView android:layout_width="@dimen/art_placeholder_icon" android:layout_height="@dimen/art_placeholder_icon" android:tint="@color/ui_dim" android:importantForAccessibility="no" android:src="@drawable/ic_music" />
                        <TextView style="@style/Muted" android:id="@+id/artHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp" android:padding="8dp" android:maxLines="2" android:text="@string/carplay_music_hint" />
                    </LinearLayout>
                </com.mustangos.launcher.ui.SquareFrameLayout>
            </FrameLayout>
            <TextView style="@style/Title" android:id="@+id/songTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="@dimen/media_title_size" android:maxLines="2" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:text="@string/media_no_data" />
            <TextView style="@style/Muted" android:id="@+id/songArtist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="@dimen/media_artist_size" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end" android:text="@string/media_connect_source" />
            <TextView style="@style/Muted" android:id="@+id/songAlbum" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:textSize="12sp" android:textColor="@color/ui_dim" android:maxLines="1" android:ellipsize="end" />
            <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp" android:progressTint="@color/ui_accent" android:progressBackgroundTint="@color/ui_border" android:max="1000" android:importantForAccessibility="no" />
            <TextView style="@style/Muted" android:id="@+id/songTime" android:layout_width="match_parent" android:layout_height="18dp" android:gravity="center_vertical" android:textSize="11sp" android:maxLines="1" android:text="@string/media_unknown_time" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/play_size" android:gravity="center">
                <ImageButton style="@style/MediaButton" android:id="@+id/previous" android:layout_width="@dimen/control_size" android:layout_height="@dimen/control_size" android:src="@drawable/ic_previous" android:contentDescription="@string/media_previous" android:enabled="false" />
                <ImageButton style="@style/MediaButton" android:id="@+id/playPause" android:layout_width="@dimen/play_size" android:layout_height="@dimen/play_size" android:src="@drawable/ic_play_pause" android:contentDescription="@string/media_toggle" android:enabled="false" android:layout_marginHorizontal="@dimen/control_spacing" android:background="@drawable/bg_play" />
                <ImageButton style="@style/MediaButton" android:id="@+id/next" android:layout_width="@dimen/control_size" android:layout_height="@dimen/control_size" android:src="@drawable/ic_next" android:contentDescription="@string/media_next" android:enabled="false" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
                <TextView style="@style/Muted" android:id="@+id/mediaStatus" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" android:gravity="center_vertical" android:layout_marginEnd="8dp" android:text="@string/media_no_access" />
                <Button style="@style/ActionButton" android:id="@+id/mediaSource" android:layout_width="80dp" android:layout_height="48dp" android:text="@string/media_choose_source" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
        <!-- Vehicle: studio render with speed and OEM state over it. -->
        <FrameLayout android:id="@+id/vehicleCard" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight=".31" android:layout_marginHorizontal="@dimen/dashboard_gap" android:background="@drawable/bg_vehicle_card" android:clipToOutline="true">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="@dimen/vehicle_stage_top" android:layout_marginBottom="@dimen/vehicle_stage_bottom">
                <com.mustangos.launcher.ui.MustangCarView android:id="@+id/carImage" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginHorizontal="8dp" android:src="@drawable/mustang_2010" android:scaleType="fitCenter" android:contentDescription="@string/vehicle_description" />
                <com.mustangos.launcher.render.MustangRenderView android:id="@+id/carRender" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:importantForAccessibility="no" />
            </FrameLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:orientation="horizontal" android:padding="@dimen/card_padding">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/PanelCaption" android:id="@+id/vehicleProfileTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:text="@string/your_mustang" />
                    <TextView style="@style/Muted" android:id="@+id/vehicleProfileSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:text="@string/engine_label" />
                    <TextView style="@style/Muted" android:id="@+id/vehicleRpm" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="11sp" android:textColor="@color/ui_dim" android:maxLines="1" android:text="— RPM · esperando datos OEM" />
                </LinearLayout>
                <com.mustangos.launcher.ui.SpeedGaugeView android:id="@+id/gauge" android:layout_width="@dimen/gauge_width" android:layout_height="@dimen/gauge_height" android:contentDescription="@string/gps_unknown_description" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:paddingStart="@dimen/card_padding" android:paddingEnd="@dimen/card_padding" android:paddingBottom="@dimen/card_padding">
                <TextView style="@style/Muted" android:id="@+id/vehicleImageReference" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/ui_dim" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:text="@string/vehicle_stock_image_caption" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView style="@style/Muted" android:id="@+id/vehicleInfo" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" android:gravity="center_vertical" android:text="@string/gps_disclaimer" />
                    <Button style="@style/ActionButton" android:id="@+id/gpsStatus" android:layout_width="wrap_content" android:maxWidth="190dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:text="@string/gps_enable" android:textSize="12sp" android:maxLines="2" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <!-- Navigation: CarPlay guidance when the iPhone publishes it, the Android map otherwise. -->
        <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight=".41" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/map_header_height" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:tint="@color/ui_accent" android:importantForAccessibility="no" android:src="@drawable/ic_navigation" />
                <TextView style="@style/PanelCaption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp" android:maxLines="1" android:text="@string/navigation_title" />
                <TextView android:id="@+id/mapStatus" style="@style/Muted" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="12dp" android:textSize="11sp" android:gravity="end" android:maxLines="1" android:singleLine="true" android:ellipsize="end" android:text="@string/map_idle_hint" />
            </LinearLayout>
            <TextView style="@style/Muted" android:id="@+id/navigationDescription" android:layout_width="match_parent" android:layout_height="@dimen/map_caption_height" android:textSize="11sp" android:textColor="@color/ui_dim" android:maxLines="1" android:ellipsize="end" android:text="@string/navigation_carplay_explanation" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/bg_map_panel" android:clipToOutline="true" android:layout_marginTop="6dp" android:layout_marginBottom="8dp">
                <FrameLayout android:id="@+id/mapHost" android:layout_width="match_parent" android:layout_height="match_parent" />
                <LinearLayout android:id="@+id/guidancePanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:layout_margin="8dp" android:orientation="vertical" android:background="@drawable/bg_guidance" android:padding="12dp" android:visibility="gone" android:clickable="true" android:focusable="true" android:contentDescription="@string/guidance_description">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <com.mustangos.launcher.ui.ManeuverView android:id="@+id/guidanceIcon" android:layout_width="@dimen/maneuver_size" android:layout_height="@dimen/maneuver_size" android:importantForAccessibility="no" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView style="@style/Title" android:id="@+id/guidanceDistance" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="@dimen/guidance_distance_size" android:fontFamily="sans-serif-medium" android:maxLines="1" />
                            <TextView style="@style/Body" android:id="@+id/guidanceInstruction" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:maxLines="2" android:ellipsize="end" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView style="@style/Body" android:id="@+id/guidanceNext" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="14sp" android:textColor="@color/ui_muted" android:maxLines="2" android:ellipsize="end" android:visibility="gone" />
                    <TextView style="@style/Muted" android:id="@+id/guidanceEta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
                    <TextView style="@style/Muted" android:id="@+id/guidanceRoad" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="13sp" android:textColor="@color/ui_dim" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
                </LinearLayout>
                <LinearLayout android:id="@+id/mapControls" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_margin="@dimen/map_controls_margin" android:orientation="@integer/map_controls_orientation" android:gravity="end">
                    <Button style="@style/ActionButton" android:id="@+id/mapZoomIn" android:layout_width="56dp" android:layout_height="48dp" android:text="@string/map_zoom_in_symbol" android:textSize="22sp" android:contentDescription="@string/map_zoom_in" android:maxLines="1" android:singleLine="true" />
                    <Button style="@style/ActionButton" android:id="@+id/mapZoomOut" android:layout_width="56dp" android:layout_height="48dp" android:layout_marginTop="@dimen/map_controls_vertical_gap" android:text="@string/map_zoom_out_symbol" android:textSize="22sp" android:contentDescription="@string/map_zoom_out" android:maxLines="1" android:singleLine="true" android:layout_marginStart="@dimen/map_controls_horizontal_gap" />
                    <Button style="@style/ActionButton" android:id="@+id/mapFollow" android:layout_width="88dp" android:layout_height="48dp" android:text="@string/map_follow" android:layout_marginTop="@dimen/map_controls_vertical_gap" android:textColor="@color/ui_accent" android:background="@drawable/bg_primary" android:maxLines="1" android:singleLine="true" android:layout_marginStart="@dimen/map_controls_horizontal_gap" android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal">
                <Button style="@style/ActionButton" android:id="@+id/openCarplay" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.35" android:layout_marginEnd="8dp" android:background="@drawable/bg_carplay_button" android:drawableStart="@drawable/ic_carplay" android:drawablePadding="8dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="@string/carplay_open" android:textSize="15sp" />
                <Button style="@style/ActionButton" android:id="@+id/openMaps" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/android_maps" android:layout_weight="1" />
            </LinearLayout>
            <TextView style="@style/Muted" android:id="@+id/mapAttribution" android:layout_width="match_parent" android:layout_height="48dp" android:visibility="gone" android:textSize="12sp" android:gravity="center_vertical" android:maxLines="2" android:clickable="true" android:focusable="true" android:contentDescription="@string/map_attribution_description" android:text="@string/map_attribution" />
            <TextView style="@style/Muted" android:id="@+id/carplayStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:text="@string/carplay_unknown_connection" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/dock" android:layout_width="match_parent" android:layout_height="@dimen/dock_height" android:paddingTop="8dp" android:paddingBottom="8dp" android:orientation="horizontal" android:baselineAligned="false">
        <Button style="@style/DockButton" android:id="@+id/dockMusic" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/dock_music" android:layout_weight="1" android:layout_marginEnd="@dimen/dashboard_gap" android:drawableTop="@drawable/ic_music" />
        <Button style="@style/DockButton" android:id="@+id/dockCarplay" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/dock_carplay" android:layout_weight="1" android:layout_marginEnd="@dimen/dashboard_gap" android:drawableTop="@drawable/ic_carplay" />
        <Button style="@style/DockButton" android:id="@+id/dockNavigation" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/dock_navigation" android:layout_weight="1" android:layout_marginEnd="@dimen/dashboard_gap" android:drawableTop="@drawable/ic_navigation" />
        <Button style="@style/DockButton" android:id="@+id/dockPhone" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/dock_phone" android:layout_weight="1" android:layout_marginEnd="@dimen/dashboard_gap" android:drawableTop="@drawable/ic_phone" />
        <Button style="@style/DockButton" android:id="@+id/dockApps" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/dock_apps" android:layout_weight="1" android:layout_marginEnd="@dimen/dashboard_gap" android:drawableTop="@drawable/ic_apps" />
        <Button style="@style/DockButton" android:id="@+id/dockEngine" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/dock_engine" android:layout_weight="1" android:layout_marginEnd="@dimen/dashboard_gap" android:drawableTop="@drawable/ic_engine" />
        <Button style="@style/DockButton" android:id="@+id/dockSettings" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/dock_settings" android:layout_weight="1" android:layout_marginEnd="0dp" android:drawableTop="@drawable/ic_settings" />
    </LinearLayout>
</LinearLayout>
