<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_mustang_wallpaper"
    android:paddingLeft="16dp"
    android:paddingRight="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/brand_name"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.12" />

        <TextView
            style="@style/Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/brand_os"
            android:textColor="#FF354A"
            android:fontFamily="sans-serif-black" />

        <TextView
            style="@style/Muted"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/vehicle_subtitle"
            android:paddingStart="12dp"
            android:paddingEnd="0dp" />

        <TextView
            android:id="@+id/topDoorStatus"
            style="@style/Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF354A"
            android:text="⚠️ PUERTA"
            android:visibility="gone"
            android:layout_marginEnd="16dp"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/topBattery"
            style="@style/Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ --.- V"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/connectivity"
            style="@style/Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/network_pending"
            android:layout_marginEnd="16dp" />

        <TextClock
            android:id="@+id/clock"
            style="@style/Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm a"
            android:format24Hour="HH:mm" />

        <ImageButton
            android:id="@+id/topSettings"
            style="@style/MediaButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/settings_description" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            style="@style/Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.29"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/card_header_height"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_music"
                    android:importantForAccessibility="no" />

                <TextView
                    style="@style/Title"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/media_title"
                    android:paddingStart="10dp"
                    android:paddingEnd="0dp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/art_margin_top"
                android:layout_marginBottom="@dimen/art_margin_bottom">

                <ImageView
                    android:id="@+id/albumArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/artwork_description"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/artPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/bg_button">

                    <ImageView
                        android:layout_width="@dimen/art_placeholder_icon"
                        android:layout_height="@dimen/art_placeholder_icon"
                        android:src="@drawable/ic_music"
                        android:alpha="0.5"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/artHint"
                        style="@style/Muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/carplay_music_hint"
                        android:layout_marginTop="10dp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/songTitle"
                style="@style/Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/media_no_data"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/songArtist"
                style="@style/Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/media_connect_source"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/songAlbum"
                style="@style/Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:maxLines="1"
                android:ellipsize="end" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:progressTint="#FF354A"
                android:progressBackgroundTint="#353B47"
                android:layout_marginTop="@dimen/progress_margin"
                android:max="1000"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/songTime"
                style="@style/Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/media_unknown_time"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/play_size"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <ImageButton
                    android:id="@+id/previous"
                    style="@style/MediaButton"
                    android:layout_width="@dimen/control_size"
                    android:layout_height="@dimen/control_size"
                    android:contentDescription="@string/media_previous"
                    android:src="@drawable/ic_previous"
                    android:enabled="false" />

                <ImageButton
                    android:id="@+id/playPause"
                    style="@style/MediaButton"
                    android:layout_width="@dimen/play_size"
                    android:layout_height="@dimen/play_size"
                    android:layout_marginHorizontal="@dimen/control_spacing"
                    android:background="@drawable/bg_primary"
                    android:contentDescription="@string/media_play"
                    android:src="@drawable/ic_play"
                    android:enabled="false" />

                <ImageButton
                    android:id="@+id/next"
                    style="@style/MediaButton"
                    android:layout_width="@dimen/control_size"
                    android:layout_height="@dimen/control_size"
                    android:contentDescription="@string/media_next"
                    android:src="@drawable/ic_next"
                    android:enabled="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/mediaStatus"
                style="@style/Muted"
                android:layout_width="match_parent"
                android:layout_height="@dimen/media_status_height"
                android:gravity="center_vertical"
                android:text="@string/media_no_access"
                android:textSize="12sp"
                android:maxLines="2" />

            <Button
                android:id="@+id/mediaSource"
                style="@style/ActionButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:text="@string/media_choose_source" />
        </LinearLayout>

        <LinearLayout
            style="@style/Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.42"
            android:layout_marginHorizontal="12dp"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                style="@style/Muted"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:text="@string/your_mustang"
                android:letterSpacing="0.18"
                android:gravity="center"
                android:textSize="12sp" />

            <com.mustangos.launcher.ui.SpeedGaugeView
                android:id="@+id/gauge"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.85"
                android:contentDescription="@string/gps_unknown_description" />

            <Button
                android:id="@+id/gpsStatus"
                style="@style/ActionButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:text="@string/gps_enable"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/carImage"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.15"
                android:src="@drawable/mustang_2010"
                android:scaleType="centerCrop"
                android:contentDescription="@string/vehicle_description" />

            <TextView
                style="@style/Title"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:text="@string/engine_label"
                android:gravity="center"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/vehicleInfo"
                style="@style/Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="28dp"
                android:text="@string/gps_disclaimer"
                android:gravity="center"
                android:textSize="13sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            style="@style/Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.29"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/card_header_height"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_navigation"
                    android:importantForAccessibility="no" />

                <TextView
                    style="@style/Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/navigation_title"
                    android:paddingStart="10dp"
                    android:paddingEnd="0dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="@dimen/navigation_icon"
                    android:layout_height="@dimen/navigation_icon"
                    android:src="@drawable/ic_navigation"
                    android:alpha="0.65"
                    android:importantForAccessibility="no" />

                <TextView
                    style="@style/Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/navigation_carplay_title"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/navigation_title_margin" />

                <TextView
                    android:id="@+id/navigationDescription"
                    style="@style/Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/navigation_carplay_explanation"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/navigation_text_margin" />

                <TextView
                    android:id="@+id/carplayStatus"
                    style="@style/Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/carplay_unknown_connection"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/navigation_status_margin"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/openCarplay"
                style="@style/ActionButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_primary"
                android:text="@string/carplay_open" />

            <Button
                android:id="@+id/openMaps"
                style="@style/ActionButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/android_maps"
                android:layout_marginTop="10dp" />

            <TextView
                style="@style/Muted"
                android:layout_width="match_parent"
                android:layout_height="@dimen/navigation_footer_height"
                android:text="@string/navigation_no_route"
                android:gravity="center"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dock_height"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <Button
            android:id="@+id/dockMusic"
            style="@style/DockButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:drawableTop="@drawable/ic_music"
            android:text="@string/dock_music" />

        <Button
            android:id="@+id/dockCarplay"
            style="@style/DockButton"
            android:layout_width="0dp"
            android:layout_weight="1.15"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:drawableTop="@drawable/ic_carplay"
            android:text="@string/dock_carplay" />

        <Button
            android:id="@+id/dockNavigation"
            style="@style/DockButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:drawableTop="@drawable/ic_navigation"
            android:text="@string/dock_navigation" />

        <Button
            android:id="@+id/dockPhone"
            style="@style/DockButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:drawableTop="@drawable/ic_phone"
            android:text="@string/dock_phone" />

        <Button
            android:id="@+id/dockRadio"
            style="@style/DockButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:drawableTop="@drawable/ic_radio"
            android:text="@string/dock_radio" />

        <Button
            android:id="@+id/dockApps"
            style="@style/DockButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:drawableTop="@drawable/ic_apps"
            android:text="@string/dock_apps" />

        <Button
            android:id="@+id/dockEngine"
            style="@style/DockButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:drawableTop="@drawable/ic_engine"
            android:text="@string/dock_engine" />

        <Button
            android:id="@+id/dockSettings"
            style="@style/DockButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:drawableTop="@drawable/ic_settings"
            android:text="@string/dock_settings" />
    </LinearLayout>
</LinearLayout>
